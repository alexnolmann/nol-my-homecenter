<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <application>
        <activity android:name=".BleSensorActivity" android:exported="true" android:launchMode="singleTop" android:screenOrientation="landscape" android:label="Проверка BLE-датчика" />
        <activity android:name=".BluetoothOutputActivity" android:exported="true" android:launchMode="singleTop" android:screenOrientation="landscape" android:label="Проверка Bluetooth-выхода" />
        <receiver android:name=".WifiFaultReceiver" android:exported="false" />
        <activity android:name=".FocusActivity" android:exported="true" android:launchMode="singleTop" android:label="H6 — проверка аудиофокуса" />
        <activity android:name=".FaultActivity" android:exported="true" android:launchMode="singleTop" android:label="H6 — проверка потери сети" />
        <service android:name=".FaultVpnService" android:exported="false" android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
        </service>
    </application>
</manifest>
