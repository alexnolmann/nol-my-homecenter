# Auto detect text files and perform LF normalization
* text=auto
/android/gradlew text eol=lf
*.gradle text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.ps1 text eol=lf
*.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Keep upstream license notices verbatim, including their original whitespace.
/android/app/src/main/assets/fonts/Anton-OFL.txt -whitespace
/android/app/src/main/assets/fonts/OFL-RobotoCondensed.txt -whitespace
