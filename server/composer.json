{
    "name": "mediacentre/home-panel",
    "description": "Native home panel backend, API and administration",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-sodium": "*",
        "ext-xml": "*",
        "ext-simplexml": "*",
        "ext-bcmath": "*",
        "nikic/fast-route": "^1.3",
        "opis/json-schema": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "MediaCentre\\": "private/app/"
        }
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    },
    "license": "MIT"
}
